rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /treasures/{treasureId} {
      allow read: if request.auth != null
        && (resource.data.visibility == "shared"
            || resource.data.ownerId == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.visibility in ["shared", "private"]
        && request.resource.data.type in ["memory","gift","flower","place","message","travel","photo","other"]
        && request.resource.data.uploaderName is string
        && request.resource.data.uploaderName.size() > 0
        && request.resource.data.uploaderName.size() <= 40
        && request.resource.data.locked is bool
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() <= 850000
        && (
          (request.resource.data.locked == false && request.resource.data.unlockAt == null)
          || (request.resource.data.locked == true
              && request.resource.data.unlockAt is timestamp
              && request.resource.data.unlockAt > request.time)
        );

      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      match /secret/{secretId} {
        allow read: if request.auth != null
          && (
            (
              get(/databases/$(database)/documents/treasures/$(treasureId)).data.ownerId == request.auth.uid
              &&
              (
                get(/databases/$(database)/documents/treasures/$(treasureId)).data.locked == false
                || get(/databases/$(database)/documents/treasures/$(treasureId)).data.unlockAt <= request.time
              )
            )
            ||
            (
              get(/databases/$(database)/documents/treasures/$(treasureId)).data.visibility == "shared"
              &&
              (
                get(/databases/$(database)/documents/treasures/$(treasureId)).data.locked == false
                || get(/databases/$(database)/documents/treasures/$(treasureId)).data.unlockAt <= request.time
              )
            )
          );

        allow create, update: if request.auth != null
          && get(/databases/$(database)/documents/treasures/$(treasureId)).data.ownerId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000;

        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/treasures/$(treasureId)).data.ownerId == request.auth.uid;
      }
    }

    match /coupleChat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 530
        && request.resource.data.createdAt == request.time;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
